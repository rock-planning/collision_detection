prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=@CMAKE_INSTALL_PREFIX@
libdir=${prefix}/lib
includedir=${prefix}/include/collision_detection

Name: @PROJECT_NAME@
Description: @PROJECT_DESCRIPTION@
Version: @PROJECT_VERSION@
Requires: @PKGCONFIG_REQUIRES_STR@
Requires.private: eigen3
Libs: -L${libdir} -lcollision_detection -labstract_collision_detection -lfcl_wrapper -lassimp
Libs.private: @Boost_SYSTEM_LIBRARY@ @Boost_FILESYSTEM_LIBRARY@ -pthread
Cflags: -I${includedir} @PKGCONFIG_CFLAGS@ -I@BOOST_INCLUDEDIR@ -I@EIGEN3_INCLUDE_DIR@
